{
  "name": "youtube-mp3-ffmpeg-server",
  "version": "1.0.0",
  "description": "Production FFmpeg Audio Decoding and YouTube MP3 Processing Server",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "prod": "NODE_ENV=production node server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop youtube-mp3-server",
    "pm2:restart": "pm2 restart youtube-mp3-server",
    "pm2:logs": "pm2 logs youtube-mp3-server",
    "pm2:status": "pm2 status",
    "generate-api-key": "node -e \"console.log('Generated API Key:', require('crypto').randomBytes(32).toString('hex'))\""
  },
  "keywords": [
    "youtube",
    "mp3",
    "ffmpeg",
    "audio-decoder",
    "browser-extension",
    "production"
  ],
  "author": "Educational Project",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.10",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "node-id3": "^0.2.6",
    "sanitize-filename": "^1.6.3"
  }
}
