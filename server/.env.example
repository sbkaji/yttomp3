# ============================================
# YouTube MP3 Server - Production Environment
# ============================================
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=production
PORT=3500
HOST=0.0.0.0

# Production Domain (your server's public URL)
# Used for CORS origin validation
PRODUCTION_URL=https://api.yourdomain.com

# API Security Key
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Download Configuration
MAX_CONCURRENCY=3
DOWNLOAD_DIR=

# Logging
LOG_LEVEL=info
