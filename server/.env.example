# ============================================================
# YouTube to MP3 Server - Environment Configuration
# ============================================================
# Works on both Windows and Ubuntu Linux (Docker, Coolify, PM2, Bare Metal)

# Server Network Settings
NODE_ENV=production
PORT=3500
HOST=0.0.0.0

# Storage & Directory Settings
# Linux default: /tmp/ytmp3_temp
# Windows default: %USERPROFILE%\Downloads\YouTube_MP3s
TEMP_DIR=/tmp/ytmp3_temp

# Public Domain / Coolify URL / Reverse Proxy URL
# Used for CORS origin authorization and generating direct download links
PRODUCTION_URL=https://ytmp3.yourdomain.com

# API Security Key
# Must match the API key configured in the Chrome extension options / popup
# Generate a strong 64-char key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# Traffic & Rate Limiting Guardrails
# General API rate limiting (15-minute window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Download Submission Rate Limit (prevents automated queue flooding per IP)
RATE_LIMIT_SUBMISSIONS_PER_MIN=30

# Queue Capacity & Concurrency Control
# Max pending/in-flight items accepted before rejecting new requests with 429
MAX_QUEUE_CAPACITY=100

# Maximum parallel video downloads & FFmpeg conversions
# If omitted or empty, automatically adapts based on CPU cores: Math.min(3, Math.max(1, Math.floor(cpus / 2)))
MAX_CONCURRENCY=2

# Storage & Memory Safety Guardrails
# Proactive LRU disk quota limit in Megabytes (default: 2048 MB = 2 GB)
# When exceeded, the oldest completed MP3 files are automatically purged
MAX_TEMP_STORAGE_MB=2048

# Maximum single download duration in milliseconds before timeout termination (default: 8 minutes)
DOWNLOAD_TIMEOUT_MS=480000

# yt-dlp Max Download File Size (prevents server disk exhaustion from 10-hour streams)
MAX_FILESIZE=350M

# Optional Binary Path Overrides (auto-detected if omitted)
# Windows: Leave blank or set to server/bin/yt-dlp.exe
# Linux: Leave blank or /usr/local/bin/yt-dlp
# YTDLP_PATH=
# FFMPEG_PATH=

# Optional Anti-Bot & Cookies Bypass (for Cloud VPS / Data Center IPs)
# Client override (defaults to: android,ios,web)
# YTDLP_CLIENT=android,ios,web

# Paste raw cookies.txt content directly in Coolify environment variables
# YTDLP_COOKIES=
# Or specify path to a cookies.txt file:
# COOKIES_PATH=/app/cookies.txt

# Optional Proxy (Residential or SOCKS5/HTTP proxy for high-volume server setups)
# YTDLP_PROXY=http://user:pass@proxy.example.com:8080

# Logging Level (info | debug | warn | error)
LOG_LEVEL=info
